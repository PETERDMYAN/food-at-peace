# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Local build config — proxy URL + app token, injected via --dart-define-from-file
dart_defines.json

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Backend (AWS SAM / Python) build + test artifacts
backend/.aws-sam/
backend/build.toml
**/__pycache__/
.pytest_cache/

# Claude Code local settings / runtime artifacts
.claude/settings.local.json
.claude/*.lock

# App Store Connect API keys — never commit secrets
*.p8
AuthKey_*.p8
dart_defines.prod.json
